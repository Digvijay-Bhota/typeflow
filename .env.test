# ─────────────────────────────────────────────────────────────────────────
# TEST-ONLY environment file — committed to git on purpose.
#
# This configures the LOCAL, DISPOSABLE Postgres container used by
# database-backed tests (see docker-compose.yml, `npm run db:test:up`).
#
# NEVER put real credentials, a Supabase URL, or any staging/production
# connection string here. tests/setup/db-env.ts and tests/setup/global-db.ts
# enforce this at runtime and will abort the entire test run if these
# values do not resolve to localhost / 127.0.0.1 / ::1 and database name
# "typeflow_test".
# ─────────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/typeflow_test
DIRECT_URL=postgresql://postgres:postgres@localhost:5434/typeflow_test
